  "assertions": [
    "sessionConnected does not imply accessibilityReady",
    "a required interpreter is an explicit participant, not a hidden gateway",
    "provider and platform labels do not alter reducer semantics",
    "required capabilities must be negotiated by the participant that needs them",
    "encrypted media legs do not support an unqualified E2EE claim when media terminates and is re-encrypted at an intermediary"
  ],
  "claimBoundary": {
    "doesNotEstablish": [
      "production VRS interoperability",
      "FaceTime interoperability",
      "WebRTC conformance",
      "SIP conformance",
      "end-to-end encryption of any production service"
    ]
  }
