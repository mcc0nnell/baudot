{
  "id": "BAUDOT-FED-001",
  "title": "Three-party accessible call assembly",
  "status": "runnable",
  "contract": "baudot.federated-call-readiness@1",
  "objective": "Reduce caller + interpreter + destination into explicit accessibility and security facts without allowing signaling success or provider labels to define readiness.",
  "federationModel": {
    "participants": [
      {
        "id": "caller",
        "role": "caller",
        "requiredCapabilities": [
          "video",
          "sign-language-video"
        ]
      },
      {
        "id": "interpreter",
        "role": "accessibility-service",
        "requiredCapabilities": [
          "video",
          "audio",
          "relay-participation"
        ]
      },
      {
        "id": "destination",
        "role": "destination",
        "requiredCapabilities": [
          "audio",
          "video"
        ]
      }
    ],
    "requiredReadiness": [
      "callerVideoReady",
      "interpreterReady",
      "destinationAudioReady"
    ]
  },
  "arms": [
    {
      "id": "control",
      "provider": "provider-a",
      "platform": "open-webrtc-peer",
      "observations": {
        "sessionConnected": true,
        "participants": {
          "caller": {
            "joined": true,
            "negotiatedCapabilities": [
              "video",
              "sign-language-video"
            ]
          },
          "interpreter": {
            "joined": true,
            "negotiatedCapabilities": [
              "video",
              "audio",
              "relay-participation"
            ]
          },
          "destination": {
            "joined": true,
            "negotiatedCapabilities": [
              "audio",
              "video"
            ]
          }
        },
        "readiness": {
          "callerVideoReady": true,
          "interpreterReady": true,
          "destinationAudioReady": true
        },
        "mediaPaths": [
          {
            "from": "caller",
            "to": "interpreter",
            "encrypted": true,
            "terminatedAt": "interpreter"
          },
          {
            "from": "interpreter",
            "to": "destination",
            "encrypted": true
          }
        ],
        "security": {
          "claimedUnqualifiedE2ee": false
        }
      }
    },
