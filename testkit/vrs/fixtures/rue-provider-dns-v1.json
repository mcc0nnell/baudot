    ]
  },
  "address": {
    "sip-tls.provider-a.example.": "127.0.0.1",
    "sip-tcp.provider-a.example.": "127.0.0.1",
    "sip-udp.provider-a.example.": "127.0.0.1"
  },
  "selectionRule": "lowest NAPTR order, then preference; SIPS+D2T is therefore selected before SIP+D2T and SIP+D2U in this controlled fixture",
  "claimBoundary": "Reserved example domains and loopback addresses only. This fixture models deterministic RFC 3263-style service selection; it is not live DNS, TND, provider, TLS PKI, or RFC 3263 conformance evidence."
