{
  "id": "BAUDOT-RFC4103-PRIMARY-001",
  "version": 1,
  "status": "baseline",
  "title": "RFC 4103 primary text/t140 RTP mapping",
  "scope": "Validates only the direct, non-redundant text/t140 RTP payload mapping using a minimal RTP v2 fixed header and one T140block. It does not establish a complete RFC 4103 sender or receiver because RFC 2198 redundancy, loss recovery, reordering, RTCP, buffering timers, and SDP negotiation are deferred.",
  "sources": [
    {
      "specification": "RFC 3550 section 5.1",
      "url": "https://www.rfc-editor.org/rfc/rfc3550.html#section-5.1",
      "basis": [
        "the RTP fixed header starts with version, marker/payload type, sequence number, timestamp, and SSRC",
        "RTP version is 2",
        "sequence number is 16 bits"
      ]
    },
    {
      "specification": "RFC 4103 sections 3.2, 3.3, and 3.5",
      "url": "https://www.rfc-editor.org/rfc/rfc4103.html",
      "basis": [
        "a direct text/t140 RTP payload consists of exactly one T140block with no additional payload-format header",
        "the timestamp clock frequency is 1000 Hz",
        "the marker bit distinguishes the first packet in a session or after an idle period from ordinary packets"
      ]
    }
  ],
  "vectors": [
    {
      "id": "ordinary-primary-text",
      "fields": {
