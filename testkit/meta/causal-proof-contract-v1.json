{
  "schema": "baudot.causal-proof-contract@1",
  "status": "experimental",
  "principle": "a stronger claim requires an explicit, acyclic derivation from evidence-bearing facts under scoped authority",
  "method": [
    "define",
    "derive",
    "execute",
    "observe",
    "prove"
  ],
  "vocabulary": {
    "fact": "An evidence-bearing observation or authority-bound decision that is not inferred merely from another component's success.",
    "rule": "A deterministic derivation that names every fact or prior claim required to produce a stronger claim.",
    "claim": "A proposition produced by one rule after all declared dependencies exist.",
    "authority": "The component or reducer allowed to assert a specific fact or produced claim; authority does not transfer by composition.",
    "evidenceReference": "A stable reference to the preserved artifact supporting a source fact.",
    "derivation": "The acyclic dependency graph connecting evidence-bearing facts through rules to a bounded claim."
  },
  "authorities": [
    {
      "id": "baudot-signaling-evidence",
      "role": "signaling and negotiation observations"
    },
    {
      "id": "baudot-semantic-reducer",
      "role": "independent RTT/T.140 semantic reduction"
    },
    {
      "id": "tilden-selection-evidence",
      "role": "route selection and route-resolution evidence"
    },
    {
      "id": "control-policy-receipt",
      "role": "execution authorization decisions"
    },
    {
      "id": "fund-policy-reducer",
      "role": "synthetic fund claim decisions"
    },
    {
      "id": "ledger-execution-observation",
      "role": "external ledger execution observations"
    },
    {
      "id": "external-implementation-observation",
      "role": "bounded observations from implementations under test"
    },
    {
      "id": "source-adapter-observation",
      "role": "normalized application/source observations"
    },
    {
      "id": "control-execution-observation",
      "role": "orchestration execution observations"
    }
  ],
  "facts": [
    {
      "id": "signaling.connected",
      "authority": "baudot-signaling-evidence",
      "evidenceRequired": true
    },
    {
      "id": "rtt.negotiated",
      "authority": "baudot-signaling-evidence",
      "evidenceRequired": true
    },
    {
      "id": "t140.semantic.observed",
      "authority": "baudot-semantic-reducer",
      "evidenceRequired": true
    },
    {
      "id": "refer.accepted",
      "authority": "baudot-signaling-evidence",
      "evidenceRequired": true
    },
    {
      "id": "replacement.dialog.established",
      "authority": "baudot-signaling-evidence",
      "evidenceRequired": true
    },
    {
      "id": "replacement.t140.semantic.observed",
      "authority": "baudot-semantic-reducer",
      "evidenceRequired": true
    },
    {
      "id": "route.resolved",
      "authority": "tilden-selection-evidence",
      "evidenceRequired": true
    },
    {
      "id": "execution.authorized",
      "authority": "control-policy-receipt",
      "evidenceRequired": true
    },
    {
      "id": "fund.claim.approved",
      "authority": "fund-policy-reducer",
      "evidenceRequired": true
    },
    {
      "id": "ledger.posted",
      "authority": "ledger-execution-observation",
      "evidenceRequired": true
    },
    {
      "id": "implementation.a.observed",
      "authority": "external-implementation-observation",
      "evidenceRequired": true
    },
    {
      "id": "implementation.b.observed",
      "authority": "external-implementation-observation",
      "evidenceRequired": true
    },
    {
      "id": "source.transcript.observed",
      "authority": "source-adapter-observation",
      "evidenceRequired": true
    },
    {
      "id": "workflow.completed",
      "authority": "control-execution-observation",
      "evidenceRequired": true
    }
  ],
  "rules": [
    {
      "id": "derive-rtt-ready",
      "requiresAll": [
        "rtt.negotiated",
        "t140.semantic.observed"
      ],
      "produces": "rtt.ready",
      "authority": "baudot-semantic-reducer"
    },
    {
      "id": "derive-replacement-rtt-ready",
      "requiresAll": [
        "replacement.dialog.established",
        "replacement.t140.semantic.observed"
      ],
      "produces": "replacement.rtt.ready",
      "authority": "baudot-semantic-reducer"
    },
    {
      "id": "derive-safe-old-leg-release",
      "requiresAll": [
        "replacement.rtt.ready"
      ],
      "produces": "old-leg.safe-to-release",
      "authority": "baudot-semantic-reducer"
    },
    {
      "id": "derive-route-execution-permitted",
      "requiresAll": [
        "route.resolved",
        "execution.authorized"
      ],
      "produces": "route.execution.permitted",
      "authority": "control-policy-receipt"
    },
    {
      "id": "derive-fund-payable-confirmed",
      "requiresAll": [
        "fund.claim.approved",
        "ledger.posted"
      ],
      "produces": "fund.payable.confirmed",
      "authority": "fund-policy-reducer"
    },
    {
      "id": "derive-implementation-agreement",
      "requiresAll": [
        "implementation.a.observed",
        "implementation.b.observed"
      ],
      "produces": "implementation.agreement.observed",
      "authority": "external-implementation-observation"
    },
    {
      "id": "derive-normalized-source-text",
      "requiresAll": [
        "source.transcript.observed"
      ],
      "produces": "source.text.normalized",
      "authority": "source-adapter-observation"
    },
    {
      "id": "derive-execution-completed",
      "requiresAll": [
        "workflow.completed"
      ],
      "produces": "execution.completed",
      "authority": "control-execution-observation"
    }
  ],
  "forbiddenPromotions": [
    {
      "fromOnly": [
        "signaling.connected"
      ],
      "to": "session.usable",
      "reason": "connected is not usable"
    },
    {
      "fromOnly": [
        "rtt.negotiated"
      ],
      "to": "rtt.ready",
      "reason": "negotiated is not ready"
    },
    {
      "fromOnly": [
        "route.resolved"
      ],
      "to": "execution.authorized",
      "reason": "routed is not authorized"
    },
    {
      "fromOnly": [
        "ledger.posted"
      ],
      "to": "fund.claim.approved",
      "reason": "ledgered is not eligible or approved"
    },
    {
      "fromOnly": [
        "implementation.agreement.observed"
      ],
      "to": "conformance",
      "reason": "implementation agreement is not conformance"
    },
    {
      "fromOnly": [
        "source.transcript.observed"
      ],
      "to": "rtt.ready",
      "reason": "a transcript observation is not T.140/RTT readiness"
    },
    {
      "fromOnly": [
        "refer.accepted"
      ],
      "to": "replacement.rtt.ready",
      "reason": "REFER acceptance is not replacement readiness"
    },
    {
      "fromOnly": [
        "workflow.completed"
      ],
      "to": "accessibility.ready",
      "reason": "orchestration completion is not accessibility readiness"
    }
  ],
  "derivationFixtures": {
    "valid": [
      {
        "id": "PROOF-VALID-RTT",
        "facts": [
          "rtt.negotiated",
          "t140.semantic.observed"
        ],
        "expectClaim": "rtt.ready"
      },
      {
        "id": "PROOF-VALID-HANDOFF",
        "facts": [
          "replacement.dialog.established",
          "replacement.t140.semantic.observed"
        ],
        "expectClaim": "old-leg.safe-to-release"
      },
      {
        "id": "PROOF-VALID-ROUTE",
        "facts": [
          "route.resolved",
          "execution.authorized"
        ],
        "expectClaim": "route.execution.permitted"
      },
      {
        "id": "PROOF-VALID-FUND",
        "facts": [
          "fund.claim.approved",
          "ledger.posted"
        ],
        "expectClaim": "fund.payable.confirmed"
      },
      {
        "id": "PROOF-VALID-AGREEMENT",
        "facts": [
          "implementation.a.observed",
          "implementation.b.observed"
        ],
        "expectClaim": "implementation.agreement.observed"
      }
    ],
    "invalid": [
      {
        "id": "PROOF-INVALID-CONNECTED",
        "facts": [
          "signaling.connected"
        ],
        "attemptedClaim": "session.usable"
      },
      {
        "id": "PROOF-INVALID-NEGOTIATED",
        "facts": [
          "rtt.negotiated"
        ],
        "attemptedClaim": "rtt.ready"
      },
      {
        "id": "PROOF-INVALID-ROUTED",
        "facts": [
          "route.resolved"
        ],
        "attemptedClaim": "execution.authorized"
      },
      {
        "id": "PROOF-INVALID-LEDGER",
        "facts": [
          "ledger.posted"
        ],
        "attemptedClaim": "fund.claim.approved"
      },
      {
        "id": "PROOF-INVALID-AGREEMENT",
        "facts": [
          "implementation.a.observed",
          "implementation.b.observed"
        ],
        "attemptedClaim": "conformance"
      },
      {
        "id": "PROOF-INVALID-TRANSCRIPT",
        "facts": [
          "source.transcript.observed"
        ],
        "attemptedClaim": "rtt.ready"
      },
      {
        "id": "PROOF-INVALID-REFER",
        "facts": [
          "refer.accepted"
        ],
        "attemptedClaim": "replacement.rtt.ready"
      },
      {
        "id": "PROOF-INVALID-WORKFLOW",
        "facts": [
          "workflow.completed"
        ],
        "attemptedClaim": "accessibility.ready"
      }
    ]
  },
  "claimBoundary": {
    "generalTheoremProver": false,
    "protocolConformance": false,
    "productionAccessibilityReadiness": false,
    "productionRoutingAuthority": false,
    "productionFundAuthority": false,
    "repositoryArchitectureGuardrail": true
  }
}
