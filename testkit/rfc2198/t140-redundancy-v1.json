{
  "id": "BAUDOT-RFC2198-T140-001",
  "version": 1,
  "status": "baseline",
  "title": "RFC 2198 redundancy container for RFC 4103 T140blocks",
  "scope": "Validates RED wire construction for text/t140 primary and redundant blocks. It does not define loss detection, sequence-number inference, recovery, reordering, redundancy-level policy, SDP fmtp negotiation, or complete RFC 4103 conformance.",
  "sources": [
    {
      "specification": "RFC 2198 section 3",
      "url": "https://www.rfc-editor.org/rfc/rfc2198.html#section-3",
      "basis": [
        "each redundant header contains F, 7-bit block payload type, 14-bit timestamp offset, and 10-bit block length",
        "the final primary block header contains only F=0 and the primary block payload type",
        "data blocks follow the headers in the same order without delimiters"
      ]
    },
    {
      "specification": "RFC 4103 sections 4.1 and 4.2",
      "url": "https://www.rfc-editor.org/rfc/rfc4103.html",
      "basis": [
        "redundant data blocks carry T140blocks from previous packets",
        "redundant T140blocks are placed in age order with the most recent redundant block last",
        "the primary T140block follows all redundant data"
      ]
    }
  ],
  "vectors": [
    {
