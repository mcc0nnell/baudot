{
  "id": "baudot.refer-provider-matrix",
  "version": 1,
  "providers": ["provider-a", "provider-b", "provider-c"],
  "transferModes": ["blind", "warm"],
  "requiredPhases": [
    "original-dialog",
    "refer",
    "notify",
    "replacement-dialog",
    "replacement-readiness",
    "old-leg-teardown"
  ],
  "pairs": [
    {"source": "provider-a", "target": "provider-b"},
    {"source": "provider-a", "target": "provider-c"},
    {"source": "provider-b", "target": "provider-a"},
    {"source": "provider-b", "target": "provider-c"},
    {"source": "provider-c", "target": "provider-a"},
    {"source": "provider-c", "target": "provider-b"}
  ],
  "reducer": {
    "referAccepted": "REFER final response is 2xx",
    "notifySuccessful": "final reported transfer outcome is 2xx",
    "replacementDialogEstablished": "replacement INVITE reached an established dialog",
    "targetCorrelated": "replacement target identity equals declared referred target",
    "rttReady": "rttNegotiated && firstT140CharacterObserved",
    "continuityPreserved": "old leg teardown occurs only after configured replacement readiness",
    "success": "referAccepted && notifySuccessful && replacementDialogEstablished && targetCorrelated && rttReady && continuityPreserved"
  },
  "cases": [
    {
      "id": "control-a-to-b-blind",
      "source": "provider-a",
      "target": "provider-b",
      "mode": "blind",
      "referFinalStatus": 202,
      "notifyFinalStatus": 200,
      "declaredReferTarget": "provider-b",
      "replacementInviteTarget": "provider-b",
      "replacementDialogEstablished": true,
      "oldLegTerminated": true,
      "oldLegTerminatedAfterReplacementReady": true,
      "rttNegotiated": true,
      "firstT140CharacterObserved": true,
      "expectedVerdict": "PASS"
    },
    {
      "id": "control-b-to-c-warm",
      "source": "provider-b",
      "target": "provider-c",
      "mode": "warm",
      "referFinalStatus": 202,
      "notifyFinalStatus": 200,
      "declaredReferTarget": "provider-c",
      "replacementInviteTarget": "provider-c",
      "replacementDialogEstablished": true,
      "oldLegTerminated": true,
      "oldLegTerminatedAfterReplacementReady": true,
      "rttNegotiated": true,
      "firstT140CharacterObserved": true,
      "expectedVerdict": "PASS"
    },
    {
      "id": "signaling-only-a-to-c",
      "source": "provider-a",
      "target": "provider-c",
      "mode": "blind",
      "referFinalStatus": 202,
      "notifyFinalStatus": 200,
      "declaredReferTarget": "provider-c",
      "replacementInviteTarget": "provider-c",
      "replacementDialogEstablished": true,
      "oldLegTerminated": true,
      "oldLegTerminatedAfterReplacementReady": true,
      "rttNegotiated": true,
      "firstT140CharacterObserved": false,
      "expectedVerdict": "FAIL_ACCESSIBILITY"
    },
    {
      "id": "refer-rejected-c-to-b",
      "source": "provider-c",
      "target": "provider-b",
      "mode": "blind",
      "referFinalStatus": 403,
      "notifyFinalStatus": null,
      "declaredReferTarget": "provider-b",
      "replacementInviteTarget": null,
      "replacementDialogEstablished": false,
      "oldLegTerminated": false,
      "oldLegTerminatedAfterReplacementReady": false,
      "rttNegotiated": false,
      "firstT140CharacterObserved": false,
      "expectedVerdict": "FAIL_SIGNALING"
    },
    {
      "id": "notify-failure-b-to-a",
      "source": "provider-b",
      "target": "provider-a",
      "mode": "blind",
      "referFinalStatus": 202,
      "notifyFinalStatus": 503,
      "declaredReferTarget": "provider-a",
      "replacementInviteTarget": null,
      "replacementDialogEstablished": false,
      "oldLegTerminated": false,
      "oldLegTerminatedAfterReplacementReady": false,
      "rttNegotiated": false,
      "firstT140CharacterObserved": false,
      "expectedVerdict": "FAIL_SIGNALING"
    },
    {
      "id": "target-drift-c-to-a",
      "source": "provider-c",
      "target": "provider-a",
      "mode": "warm",
      "referFinalStatus": 202,
      "notifyFinalStatus": 200,
      "declaredReferTarget": "provider-a",
      "replacementInviteTarget": "provider-b",
      "replacementDialogEstablished": true,
      "oldLegTerminated": false,
      "oldLegTerminatedAfterReplacementReady": false,
      "rttNegotiated": true,
      "firstT140CharacterObserved": true,
      "expectedVerdict": "FAIL_CORRELATION"
    },
    {
      "id": "premature-teardown-a-to-b-warm",
      "source": "provider-a",
      "target": "provider-b",
      "mode": "warm",
      "referFinalStatus": 202,
      "notifyFinalStatus": 200,
      "declaredReferTarget": "provider-b",
      "replacementInviteTarget": "provider-b",
      "replacementDialogEstablished": true,
      "oldLegTerminated": true,
      "oldLegTerminatedAfterReplacementReady": false,
      "rttNegotiated": true,
      "firstT140CharacterObserved": true,
      "expectedVerdict": "FAIL_CONTINUITY"
    }
  ],
  "claimBoundary": [
    "synthetic provider identities only",
    "no live SIP exchange",
    "no provider support claim",
    "no SIP or REFER conformance claim",
    "no production VRS readiness claim"
  ]
}
